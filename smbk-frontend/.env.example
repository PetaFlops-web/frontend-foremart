# Kosongkan / hapus baris ini untuk pakai default '/api' (lewat proxy Vite).
# Isi kalau frontend di-deploy terpisah dari backend dan tidak lewat proxy.
# VITE_API_BASE=http://127.0.0.1:8080/api

# Dipakai vite.config.js untuk target proxy /api saat development.
VITE_BACKEND_URL=http://127.0.0.1:8080
